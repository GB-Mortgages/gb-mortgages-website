---
layout: base.njk
permalink: /faqs/
eleventyComputed:
  pageTitle: "{{ faqs.seo_title }}"
  pageDescription: "{{ faqs.seo_description }}"
---
{%- set f = faqs -%}
<main class="pt-[72px]">
<section class="mx-auto max-w-[1440px] px-5 pb-12 pt-14 sm:px-10 lg:pt-20">
  <a href="/" class="group inline-flex items-center gap-2 text-sm font-medium text-[#064530]"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:-translate-x-1" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg> Back to home</a>
  <div class="mt-10 grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-8">
      <p class="text-xs font-medium uppercase tracking-[0.22em] text-[#4C6B55]">{{ f.eyebrow }}</p>
      <h1 class="mt-6 font-display text-4xl font-black leading-[1.02] tracking-[-0.03em] text-[#064530] sm:text-5xl sm:leading-[1] lg:text-6xl">{{ f.heading }}<span class="text-[#F2B705]">.</span></h1>
    </div>
    <div class="lg:col-span-4 lg:pt-10">
      <p class="text-base leading-relaxed text-[#4F5B53]">{{ f.intro }}</p>
    </div>
  </div>
</section>
<section class="mx-auto max-w-[1440px] px-5 pb-28 sm:px-10">
  <div class="mx-auto max-w-3xl">
    {%- for it in f.items %}
    <article id="faq-{{ loop.index }}" class="scroll-mt-24 border-t border-[#D3CCBD] py-10">
      <h2 class="text-2xl font-semibold leading-snug tracking-tight text-[#064530]">{{ it.q }}</h2>
      <div class="mt-4 space-y-4 text-base leading-relaxed text-[#4F5B53] sm:text-lg">
        {%- for b in it.a %}
          {%- if b.ol %}
        <ol class="list-decimal space-y-3 pl-6">
          {%- for li in b.ol %}<li>{{ li }}</li>{% endfor %}
        </ol>
          {%- else %}
        <p>{{ b }}</p>
          {%- endif %}
        {%- endfor %}
      </div>
    </article>
    {%- endfor %}
    <div class="border-t border-b border-[#D3CCBD] py-10">
      <p class="font-display text-2xl font-semibold text-[#064530]">Still have a question?</p>
      <p class="mt-2 text-base text-[#4F5B53]">Get in touch and I'll answer it directly. <a href="/#talk" class="font-medium text-[#064530] underline decoration-[#F2B705] decoration-2 underline-offset-4">Talk to Philippa</a>.</p>
    </div>
  </div>
</section>
</main>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for it in f.items %}
    {
      "@type": "Question",
      "name": {{ it.q | json | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ it.plain | json | safe }} }
    }{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>
