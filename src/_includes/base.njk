<!doctype html>
<html lang="en-NZ">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pageTitle or site.seo_title }}</title>
<meta name="description" content="{{ pageDescription or site.seo_description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.business_name }}">
<meta property="og:title" content="{{ pageTitle or site.seo_title }}">
<meta property="og:description" content="{{ pageDescription or site.seo_description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}{{ hero.photo }}">
<meta property="og:locale" content="en_NZ">
<meta name="theme-color" content="#064530">
<link rel="icon" href="/images/favicon.png" type="image/png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=DM+Sans:opsz,wght@9..40,400..700&display=swap">
<link rel="stylesheet" href="/assets/styles.css">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FinancialService",
  "name": {{ site.business_name | json | safe }},
  "slogan": {{ site.tagline | json | safe }},
  "url": {{ site.url | json | safe }},
  "image": {{ (site.url + hero.photo) | json | safe }},
  "logo": {{ (site.url + "/images/logo-full.png") | json | safe }},
  "email": {{ site.email | json | safe }},
  "telephone": {{ site.phone | json | safe }},
  "description": {{ site.seo_description | json | safe }},
  "address": { "@type": "PostalAddress", "addressLocality": "Queenstown", "addressRegion": "Otago", "addressCountry": "NZ" },
  "areaServed": {{ site.areas_served | json | safe }},
  "founder": { "@type": "Person", "name": {{ site.adviser_name | json | safe }}, "jobTitle": "Mortgage adviser" }
}
</script>
</head>
<body>
<div id="top" class="overflow-x-clip">
{% include "header.njk" %}
{{ content | safe }}
{% include "footer.njk" %}
</div>
<script src="/assets/site.js" defer></script>
</body>
</html>
