{
  "name": "gb-mortgages-website",
  "private": true,
  "version": "1.0.0",
  "description": "GB Mortgages website. Eleventy, Tailwind and Decap CMS, hosted on Netlify.",
  "scripts": {
    "build:css": "tailwindcss -i src/assets/styles.css -o _site/assets/styles.css --minify",
    "build:site": "eleventy",
    "build": "npm run build:site && npm run build:css",
    "dev": "eleventy --serve & tailwindcss -i src/assets/styles.css -o _site/assets/styles.css --watch",
    "cms": "npx decap-server"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.0.0",
    "decap-server": "3.11.6",
    "markdown-it": "14.1.0",
    "tailwindcss": "3.4.17"
  }
}
